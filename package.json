{
  "name": "julie-ann-aguirre-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "dev": "tsx scripts/prepare-routes.ts && next dev --webpack",
